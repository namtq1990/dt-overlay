/*
 * Overlay description for Nucare SPRD kouni
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/mfd/atmel-flexcom.h>
#include <dt-bindings/pinctrl/at91.h>

&{/} {
	spi_gpio: spi-gpio {
		compatible = "spi-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_flx3_gpio>;
		status = "okay";
		sck-gpios = <&pioC 26 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&pioC 22 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&pioC 23 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&pioC 25 GPIO_ACTIVE_LOW>;
		num-chipselects = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		spidev@0 {
			compatible = "linux,spidev";
			reg = <0>;
			spi-max-frequency = <2000000>;
		};
	};
};

&pinctrl {
	flexcom {
		pinctrl_flx3_gpio: flx3_gpio {
			atmel,pins =
				<AT91_PIOC 22 AT91_PERIPH_GPIO AT91_PINCTRL_NONE
				 AT91_PIOC 23 AT91_PERIPH_GPIO AT91_PINCTRL_NONE
				 AT91_PIOC 26 AT91_PERIPH_GPIO AT91_PINCTRL_NONE
				 AT91_PIOC 25 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
		};

		pinctrl_flx3_spi: flx3_spi {
			atmel,pins =
				<AT91_PIOC 22 AT91_PERIPH_B AT91_PINCTRL_NONE
				 AT91_PIOC 23 AT91_PERIPH_B AT91_PINCTRL_PULL_UP
				 AT91_PIOC 26 AT91_PERIPH_B AT91_PINCTRL_NONE
				 AT91_PIOC 25 AT91_PERIPH_B AT91_PINCTRL_PULL_UP>;
		};

		pinctrl_flx9_twi: flx9_twi {
			atmel,pins =
				<AT91_PIOC 8 AT91_PERIPH_C AT91_PINCTRL_PULL_UP
				 AT91_PIOC 9 AT91_PERIPH_C AT91_PINCTRL_PULL_UP>;
		};
	};
};

&flx9 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
	status = "okay";

	i2c9: i2c@600 {
		#address-cells = <1>;
		#size-cells = <0>;
		dmas = <0>, <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_flx9_twi>;
		status = "okay";
		
		gyro@1e {
			compatible = "honeywell,hmc5883l";
			reg = <0x1e>;
			status = "disabled";
		};
		
		imu@68 {
			compatible = "invensense,icm20948";
			reg = <0x68>;
			status = "okay";
		};
	};
};

&uart9 {
	status = "disabled";
};

&flx3 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_SPI>;
	status = "disabled";

	spi3: spi@400 {
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_flx3_spi>;
		status = "disabled";

		spidev@0 {
			compatible = "linux,spidev";
			reg = <0>;
			spi-max-frequency = <2000000>;
			spi-cpha;
		};
	};
};
